# Copy to /etc/tidymac/backend.env on the server (chmod 600, owned by root). Never commit the real file.
# staging/production FAIL CLOSED: the server refuses to start if anything below is missing or unsafe.

APP_ENV=production
PORT=8787
HOST=127.0.0.1                  # keep on loopback; Nginx is the only public entry
TRUST_PROXY=1                   # 1 only because Nginx sets X-Forwarded-For
WEBSITE_URL=                    # https://<your website origin>   (https required)
LICENSE_API_URL=                # https://<this API's public address>
ALLOWED_ORIGINS=                # https://<your website origin>   (comma separated, exact origins)
DATABASE_PATH=/var/lib/tidymac/licensing.sqlite   # persistent; ':memory:' is refused

# License signing (Ed25519). Generate once with: npm run keys   Back up the private key; if lost, every installed app needs a new public key.
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_KID=k1
CODE_HMAC_SECRET=               # 32+ random characters
LICENSE_KEY_SECRET=             # 32+ random characters, different from the one above

# Payments (mock is refused in staging/production)
PAYMENT_PROVIDER=paddle
PADDLE_MODE=sandbox             # sandbox for staging, live for production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=

# Sign in with Google (mock is refused in staging/production)
IDENTITY_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SIGNIN_TTL_SECONDS=600

# Email (console is development-only)
EMAIL_PROVIDER=resend
EMAIL_FROM=                     # "TidyMac <noreply@your-verified-domain>"
RESEND_API_KEY=

# Policy (defaults shown; change deliberately)
# TRIAL_HOURS=24
# MAX_DEVICES=1
# OFFLINE_GRACE_DAYS=30
# CODE_TTL_SECONDS=600
# CODE_MAX_ATTEMPTS=5
# CODE_COOLDOWN_SECONDS=30
# RATE_CODE_PER_EMAIL_HOUR=5
# RATE_CODE_PER_IP_HOUR=20
# RATE_CODE_PER_INSTALLATION_HOUR=10
# RATE_VERIFY_PER_IP_HOUR=40
# RATE_KEY_ATTEMPTS_PER_IP_HOUR=10
# WEBHOOK_TOLERANCE_SECONDS=300
